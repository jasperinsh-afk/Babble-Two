# ── 运行环境 ──
# production：关闭调试、Cookie 启用 Secure（需 HTTPS）；本地开发保持 development
APP_ENV=development
DEBUG=true

# ── 数据库（运营后台 / 墨麟导出用）──
DATABASE_URL=sqlite+aiosqlite:///./data/goqd.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
SECRET_KEY=please-change-me-to-a-long-random-string

# ── 微信云开发（网页版直连云数据库的关键三项）──
# AppID 已填；AppSecret 在微信公众平台 → 开发管理 → 开发设置 中获取
WECHAT_APPID=wx8d676279f2d09146
WECHAT_SECRET=
WECHAT_CLOUD_ENV=cloud1-d1gz1h52b5f884504

# ── 运营后台 ──
INGEST_TOKEN=change-me-ingest-token
ADMIN_WEB_TOKEN=change-me-admin-token
# 版主 / 审核员自助开通账号的授权码，正式部署请改成自己的值
CLUB_MODERATOR_AUTH_CODE=0923
REVIEWER_AUTH_CODE=2012
# 后台账号会话有效期（分钟）
ADMIN_SESSION_MINUTES=480

# ── 网页版 bala-web / 三端互通 ──
# cloud：网页客户端与网页后台都读写微信云数据库，与小程序数据一致（正式上线必须）
# local：只用本地 SQLite 演示库，不与小程序互通（仅本地演示）
# auto：WECHAT_SECRET 与 WECHAT_CLOUD_ENV 都配好就走云数据库，否则回落本地
WEB_DATA_MODE=auto
WEB_LOCAL_DB=./data/bala_web.db
WEB_SEED_FILE=../cloudfunctions/seedImport/seed_data.json
# 本地种子日期整体平移，让最新一条落在「今天 + 10 天」，保证演示时投票/活动仍在进行
WEB_SEED_SHIFT_DATES=true
WEB_CACHE_ENABLED=true
# 部署更新后的 5 个云函数之前保持 false，避免产生 _openid 为空的脏数据
WEB_CLOUD_WRITE_ENABLED=false

# ── 网页端 ↔ 小程序账号绑定（绑定码方案，无需开放平台 UnionID）──
# 原理：小程序「我的 → 绑定网页端」生成 6 位一次性码，网页端「本地足迹 → 账号互通」
# 输入后，服务端把 web:<uuid> 与微信 openid 关联，此后网页请求注入 linked:<openid>，
# 云函数把投票 / 打卡 / 达人分 / 日程写到同一个微信账号下。
# 启用清单：
#   1. 部署 identity 云函数（新增 issueBindCode，会自动创建 bind_codes / identity_links 集合）
#   2. 部署 vote / club / event / scan / me / analytics / leaderboard / days 八个云函数
#      （resolveOpenid 已支持 linked: 前缀）
#   3. 填好上面的 WECHAT_APPID / WECHAT_SECRET / WECHAT_CLOUD_ENV
#   4. WEB_DATA_MODE=cloud（或保持 auto），WEB_CLOUD_WRITE_ENABLED=true
# 注意：绑定关系存于云数据库 identity_links，换浏览器或清除 localStorage 后需重新绑定。
