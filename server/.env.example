# ── 数据库（运营后台 / 墨麟导出用）──
DATABASE_URL=sqlite+aiosqlite:///./data/goqd.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
SECRET_KEY=please-change-me-to-a-long-random-string

# ── 微信云开发（网页版直连云数据库的关键三项）──
# AppID 已填；AppSecret 在微信公众平台 → 开发管理 → 开发设置 中获取
WECHAT_APPID=wx8d676279f2d09146
WECHAT_SECRET=
WECHAT_CLOUD_ENV=cloud1-d1gz1h52b5f884504

# ── 运营后台 ──
INGEST_TOKEN=change-me-ingest-token
ADMIN_WEB_TOKEN=change-me-admin-token

# ── 网页版 bala-web ──
# auto：WECHAT_SECRET 与 WECHAT_CLOUD_ENV 都配好就走云数据库，否则用本地 SQLite 演示库
# 也可强制指定 cloud 或 local
WEB_DATA_MODE=auto
WEB_LOCAL_DB=./data/bala_web.db
WEB_SEED_FILE=../cloudfunctions/seedImport/seed_data.json
# 本地种子日期整体平移，让最新一条落在「今天 + 10 天」，保证演示时投票/活动仍在进行
WEB_SEED_SHIFT_DATES=true
WEB_CACHE_ENABLED=true
# 部署更新后的 5 个云函数之前保持 false，避免产生 _openid 为空的脏数据
WEB_CLOUD_WRITE_ENABLED=false
