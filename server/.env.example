# ── 应用 ──
APP_NAME=七德通 GoQD
APP_ENV=development          # development | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── 数据库 ──
# SQLite（开发默认，零依赖）
DATABASE_URL=sqlite+aiosqlite:///./data/goqd.db
# PostgreSQL（生产）
# DATABASE_URL=postgresql+asyncpg://goqd:password@localhost:5432/goqd

# ── 安全 ──
SECRET_KEY=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false          # false 时自动降级为进程内 LRU 缓存

# ── CORS ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 学校身份校验 ──
SCHOOL_EMAIL_DOMAIN=@qd.baoan.edu.cn
STUDENT_ID_PATTERN=^\d{8}$

# ── 墨麟书院 · 输入层（爬虫）──
CRAWLER_ENABLED=false
CRAWLER_SCHEDULE_HOURS=9,15
CRAWLER_SOURCES=weibo,zhihu,bilibili,baidu,cctv

# ── 通义千问 LLM ──
DASHSCOPE_API_KEY=
QWEN_MODEL_SELECT=qwen-max        # 筛选 / 审核：准确优先
QWEN_MODEL_GENERATE=qwen-plus     # 生成 / 分类：成本优先
LLM_TIMEOUT=10
LLM_ENABLED=false                 # false 时跳过 LLM，话题转人工队列

# ── OMEGA / NFC ──
NFC_BASE_URL=https://goqd.com/nfc
IOS_APP_STORE_URL=https://apps.apple.com/app/goqd/idXXXXXXXX
ANDROID_STORE_URL=https://www.coolapk.com/apk/com.goqd.app

# ── 推送 ──
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
PUSH_ENABLED=false                # false 时仅写站内信
PUSH_QUIET_HOURS_START=22
PUSH_QUIET_HOURS_END=7
PUSH_DAILY_LIMIT=5

# ── 对象存储 ──
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ── 内容安全 ──
MODERATION_AUTO_APPROVE=false     # true 时跳过人工队列（仅开发用）
