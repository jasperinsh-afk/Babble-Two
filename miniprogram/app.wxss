/**
 * 叭啦 Babble —— 全局样式与设计令牌（品牌 V2.0 · 紫橙体系）
 *
 * 色彩令牌与《叭啦-品牌形象文档》完全一致；
 * 页面一律引用变量，禁止写死色值。
 */

page {
  /* 品牌主色 · 叭啦紫 */
  --primary: #8b5cf6;
  --primary-light: #a78bfa;
  --primary-violet: #7c3aed;

  /* 品牌辅色 · 星芒橙 */
  --accent: #f97316;
  --accent-dark: #ea580c;
  --accent-light: #fdba74;

  /* 点缀青 */
  --mint: #06b6d4;

  /* 品牌标准渐变：紫 → 橙 */
  --gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #f97316 100%);

  --bg-page: #faf8ff;
  --bg-card: #ffffff;
  --bg-tint: #f3edfd;

  --text-strong: #1e1b2e;
  --text-normal: #5c5775;
  --text-weak: #9d96b8;

  --success: #22c55e;
  --danger: #ef4444;
  --warning: #f59e0b;

  --radius-s: 12rpx;
  --radius-m: 20rpx;
  --radius-l: 28rpx;
  --radius-pill: 999rpx;

  --shadow-s: 0 4rpx 16rpx rgba(30, 27, 46, 0.05);
  --shadow-m: 0 8rpx 32rpx rgba(139, 92, 246, 0.1);
  --shadow-l: 0 16rpx 48rpx rgba(139, 92, 246, 0.16);

  --safe-bottom: env(safe-area-inset-bottom);

  background: var(--bg-page);
  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  color: var(--text-strong);
  font-size: 26rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
swiper,
image {
  box-sizing: border-box;
}

/* ---------------------------------------------------------------- 布局 */

.page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + var(--safe-bottom));
}

.page--plain {
  padding-bottom: calc(40rpx + var(--safe-bottom));
}

.safe-bottom {
  padding-bottom: var(--safe-bottom);
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
}

/* ---------------------------------------------------------------- 卡片 */

.card {
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  overflow: hidden;
}

.card--tint {
  background: var(--bg-tint);
  box-shadow: none;
}

.card--gradient {
  background: var(--gradient-primary);
  color: #ffffff;
  box-shadow: var(--shadow-m);
}

.section {
  margin: 32rpx 24rpx;
}

/* ---------------------------------------------------------------- 文本 */

.title-lg {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.title-md {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.title-sm {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-strong);
}

.text-body {
  font-size: 26rpx;
  color: var(--text-normal);
}

.text-weak {
  font-size: 24rpx;
  color: var(--text-weak);
}

.text-strong {
  font-size: 26rpx;
  color: var(--text-strong);
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------------------------------------------------------------- 徽章 */

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-tint);
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 500;
}

.chip--solid {
  background: var(--gradient-primary);
  color: #ffffff;
  box-shadow: var(--shadow-s);
}

.chip--success {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.chip--warning {
  background: rgba(245, 158, 11, 0.12);
  color: var(--warning);
}

.chip--danger {
  background: rgba(239, 68, 68, 0.12);
  color: var(--danger);
}

/* ---------------------------------------------------------------- 按钮 */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-pill);
  background: var(--gradient-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--shadow-m);
  transition: transform 0.18s ease, opacity 0.18s ease;
}

.btn--disabled {
  background: #ede9fe;
  color: var(--text-weak);
  box-shadow: none;
}

.btn--ghost {
  background: var(--bg-tint);
  color: var(--primary);
  box-shadow: none;
}

.btn--pressed {
  transform: scale(0.97);
  opacity: 0.85;
}

.btn-fixed {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(32rpx + var(--safe-bottom));
  z-index: 20;
}

/* ---------------------------------------------------------------- 动效 */

@keyframes fade-up {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-up {
  animation: fade-up 0.42s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.pop-in {
  animation: pop-in 0.36s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes glow {
  0% {
    box-shadow: 0 0 0 0 rgba(139, 92, 246, 0.4);
  }
  100% {
    box-shadow: 0 0 0 32rpx rgba(139, 92, 246, 0);
  }
}

.glow {
  animation: glow 1.1s ease-out infinite;
}

/* ---------------------------------------------------------------- 其他 */

.divider {
  height: 1rpx;
  background: rgba(30, 27, 46, 0.06);
  margin: 24rpx 0;
}

.hairline-top {
  border-top: 1rpx solid rgba(30, 27, 46, 0.06);
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-2 > view {
  width: 49%;
}
