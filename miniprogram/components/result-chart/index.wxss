.result-chart {
  background: var(--bg-card);
  border-radius: var(--radius-l);
  padding: 28rpx;
  box-shadow: var(--shadow-s);
}

.result-chart__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}

.result-chart__total {
  display: flex;
  align-items: baseline;
}

.result-chart__total-num {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--primary);
  margin-right: 12rpx;
}

.result-chart__total-label {
  font-size: 24rpx;
  color: var(--text-weak);
}

.result-chart__pk {
  display: flex;
  align-items: center;
}

.result-chart__pk-item {
  text-align: center;
}

.result-chart__pk-num {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary);
}

.result-chart__pk-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-weak);
  max-width: 140rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-chart__pk-right .result-chart__pk-num {
  color: var(--warning);
}

.result-chart__pk-vs {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-weak);
  margin: 0 20rpx;
}

.result-chart__row {
  margin-bottom: 24rpx;
}

.result-chart__info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.result-chart__label {
  font-size: 26rpx;
  color: var(--text-strong);
  max-width: 60%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.result-chart__value {
  font-size: 22rpx;
  color: var(--text-weak);
}

.result-chart__bar-bg {
  position: relative;
  height: 16rpx;
  background: rgba(30, 27, 46, 0.05);
  border-radius: 999rpx;
  overflow: hidden;
}

.result-chart__bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.result-chart__percent {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

.result-chart__pk-bar {
  display: flex;
  height: 32rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(139, 92, 246, 0.08);
}

.result-chart__pk-fill {
  height: 100%;
  transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.result-chart__pk-fill--left {
  background: linear-gradient(135deg, #7C3AED 0%, #8B5CF6 100%);
}

.result-chart__pk-fill--right {
  background: linear-gradient(135deg, #F97316 0%, #FDBA74 100%);
}
