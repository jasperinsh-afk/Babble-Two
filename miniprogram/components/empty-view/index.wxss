.empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: var(--text-weak);
}

.empty-view__icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.55;
}

.empty-view__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-normal);
  margin-bottom: 8rpx;
}

.empty-view__subtitle {
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.empty-view__action {
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-tint);
  color: var(--primary);
  font-size: 26rpx;
}
