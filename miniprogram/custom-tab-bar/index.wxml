<cover-view class="tab-bar">
  <cover-view class="tab-bar__safe"></cover-view>
  <cover-view
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <cover-image class="tab-bar__icon" src="{{selected === index ? item.selectedIconPath : item.iconPath}}" />
    <cover-view class="tab-bar__label">{{item.text}}</cover-view>
  </cover-view>
</cover-view>
