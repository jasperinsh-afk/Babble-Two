page { background: var(--bg-page); }
.day-create { min-height: 100vh; padding: 40rpx 40rpx calc(60rpx + var(--safe-bottom)); box-sizing: border-box; }
.day-create__intro { margin-bottom: 48rpx; }
.day-create__eyebrow { color: var(--primary); font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.day-create__title { margin-top: 10rpx; color: var(--text-strong); font-size: 48rpx; font-weight: 700; }
.day-create__subtitle { margin-top: 10rpx; color: var(--text-weak); font-size: 24rpx; }
.day-create__fields { width: 100%; }
.day-field { position: relative; margin-bottom: 34rpx; }
.day-field__label { margin-bottom: 14rpx; color: var(--text-strong); font-size: 26rpx; font-weight: 600; }
.day-field__label text { margin-left: 8rpx; color: var(--text-weak); font-size: 20rpx; font-weight: 400; }
.day-field input,.day-field textarea,.day-field__picker { width: 100%; border: 2rpx solid #E8E1F0; border-radius: 24rpx; background: var(--bg-card); color: var(--text-strong); font-size: 28rpx; font-weight: 400; box-sizing: border-box; }
.day-field input { height: 92rpx; padding: 0 26rpx; }
.day-field__picker { display: flex; height: 92rpx; align-items: center; justify-content: space-between; padding: 0 26rpx; }
.day-field__picker text { color: var(--text-weak); font-size: 22rpx; }
.day-field textarea { min-height: 190rpx; padding: 22rpx 26rpx 44rpx; line-height: 1.6; }
.day-field__count { position: absolute; right: 22rpx; bottom: 14rpx; color: var(--text-weak); font-size: 18rpx; }
.day-create__error { margin-bottom: 18rpx; color: var(--danger); font-size: 24rpx; text-align: center; }
.day-create__footer { margin-top: 20rpx; }
.day-create__submit { display: flex; width: 100%; min-height: 96rpx; height: 96rpx; align-items: center; justify-content: center; border-radius: 48rpx; background: #8B5CF6; background: var(--gradient-primary); color: #FFF; font-size: 30rpx; font-weight: 600; box-shadow: var(--shadow-m); box-sizing: border-box; }
.day-create__submit:active { transform: scale(.98); opacity: .9; }
.day-create__hint { margin-top: 18rpx; color: var(--text-weak); font-size: 21rpx; text-align: center; }
@media (max-width: 340px) { .day-create__title { font-size: 42rpx; } .day-create__intro { margin-bottom: 32rpx; } .day-field { margin-bottom: 24rpx; } }
