.page--profile {
  padding-bottom: 40rpx;
}

.profile-header {
  padding: 32rpx 24rpx 8rpx;
}

.profile-header__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-strong);
  margin-bottom: 8rpx;
}

.profile-header__subtitle {
  font-size: 24rpx;
  color: var(--text-weak);
}

.profile-stats {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 32rpx 24rpx;
}

.profile-stat {
  flex: 1;
  text-align: center;
}

.profile-stat__num {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  color: transparent;
}

.profile-stat__label {
  font-size: 24rpx;
  color: var(--text-weak);
}

.profile-stat__divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(30, 27, 46, 0.06);
}

.profile-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.profile-badge {
  width: 31.3%;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-s);
}

.profile-badge__icon {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: var(--bg-page);
  font-size: 36rpx;
  color: var(--text-weak);
}

.profile-badge--unlocked .profile-badge__icon {
  background: var(--gradient-primary);
  color: #fff;
  box-shadow: var(--shadow-m);
}

.profile-badge__name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 6rpx;
}

.profile-badge__desc {
  font-size: 20rpx;
  color: var(--text-weak);
  line-height: 1.4;
}

.profile-badge__earned {
  font-size: 18rpx;
  color: var(--primary);
  margin-top: 6rpx;
}

.profile-foot {
  padding: 0 24rpx;
}

.profile-foot__item {
  display: flex;
  align-items: flex-start;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-s);
}

.profile-foot__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.profile-foot__dot--vote {
  background: var(--primary);
}

.profile-foot__dot--scan {
  background: var(--warning);
}

.profile-foot__title {
  font-size: 28rpx;
  color: var(--text-strong);
}

.profile-foot__time {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}
