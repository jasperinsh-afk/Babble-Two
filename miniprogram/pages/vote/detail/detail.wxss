.page--vote-detail {
  padding-bottom: calc(160rpx + var(--safe-bottom));
}

.vote-detail__header {
  padding: 28rpx;
}

.vote-detail__tags {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.vote-detail__tags .chip {
  margin-right: 12rpx;
}

.vote-detail__time {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-weak);
}

.vote-detail__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.vote-detail__desc {
  font-size: 26rpx;
  color: var(--text-normal);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.vote-detail__count {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.vote-detail__options {
  padding: 28rpx;
}

.vote-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: var(--radius-m);
  background: var(--bg-page);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.vote-option:last-child {
  margin-bottom: 0;
}

.vote-option--selected {
  border-color: var(--primary);
  background: rgba(139, 92, 246, 0.06);
}

.vote-option__check {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vote-option__circle {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid var(--text-weak);
  transition: all 0.2s ease;
}

.vote-option--selected .vote-option__circle {
  border-width: 12rpx;
  border-color: var(--primary);
}

.vote-option__square {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 4rpx solid var(--text-weak);
  position: relative;
  transition: all 0.2s ease;
}

.vote-option--selected .vote-option__square {
  border-color: var(--primary);
  background: var(--gradient-primary);
}

.vote-option--selected .vote-option__square::after {
  content: '✓';
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  text-align: center;
  line-height: 32rpx;
  font-size: 22rpx;
  color: #fff;
}

.vote-option__body {
  flex: 1;
  min-width: 0;
}

.vote-option__label {
  font-size: 28rpx;
  color: var(--text-strong);
  font-weight: 500;
}

.vote-option__count {
  display: block;
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

.vote-detail__submit {
  background: #fff;
  padding: 24rpx;
  box-shadow: 0 -8rpx 32rpx rgba(30, 27, 46, 0.08);
  border-radius: 28rpx 28rpx 0 0;
}

.vote-detail__submit .btn {
  position: static;
  width: 100%;
  margin: 0;
}

.vote-detail__voted-tip {
  margin: 24rpx;
  padding: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-weak);
}

.vote-detail__chain {
  padding: 28rpx;
}

.vote-detail__chain-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.vote-detail__chain-bar {
  height: 16rpx;
  background: rgba(30, 27, 46, 0.05);
  border-radius: 999rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.vote-detail__chain-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  transition: width 0.5s ease;
}

.vote-detail__chain-text {
  font-size: 24rpx;
  color: var(--text-normal);
  margin-bottom: 24rpx;
}

.vote-detail__chain-full {
  margin-left: 12rpx;
  color: var(--danger);
  font-weight: 500;
}

.vote-detail__loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: var(--text-weak);
}
