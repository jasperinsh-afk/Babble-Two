button{margin:0;padding:0;border:0;background:none;min-width:0;line-height:1.4}button::after{border:0}.leaderboard-page{width:100%;max-width:900rpx;min-height:100vh;margin:0 auto;padding:30rpx 28rpx 0;overflow-x:hidden;box-sizing:border-box}.leaderboard-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-bottom:28rpx}.leaderboard-header>view:first-child{min-width:0;flex:1}.leaderboard-header__eyebrow{color:var(--text-weak);font-size:22rpx}.leaderboard-header__title{margin-top:4rpx;font-size:50rpx;font-weight:700;letter-spacing:-2rpx}.leaderboard-header__week{padding-bottom:8rpx;color:var(--text-weak);font-size:20rpx;white-space:nowrap}.my-score{padding:32rpx;border-radius:36rpx;background:linear-gradient(135deg,#272238,#514475);color:#FFF;box-shadow:var(--shadow-m)}.my-score__top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.my-score__top>view{min-width:0;flex:1}.my-score__label{color:rgba(255,255,255,.65);font-size:21rpx}.my-score__nickname{margin-top:6rpx;overflow:hidden;font-size:30rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.my-score__top button{flex-shrink:0;padding:12rpx 22rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:28rpx;color:#FFF;font-size:22rpx}.my-score__numbers{display:flex;margin-top:32rpx}.my-score__numbers>view{display:flex;min-width:0;flex:1;flex-direction:column;align-items:center;border-right:1rpx solid rgba(255,255,255,.12)}.my-score__numbers>view:last-child{border-right:0}.my-score__numbers text{font-size:48rpx;font-weight:700}.my-score__numbers small{margin-top:6rpx;color:rgba(255,255,255,.6);font-size:20rpx}.my-score__medal{display:flex;align-items:center;gap:10rpx;margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.12);color:#FADBA0;font-size:21rpx}.my-score__medal text{display:flex;width:34rpx;height:34rpx;align-items:center;justify-content:center;border-radius:50%;background:#D5A84F;color:#FFF;font-size:22rpx;line-height:1}.weekly-champion{display:flex;align-items:center;gap:22rpx;margin-top:24rpx;padding:28rpx;border:1rpx solid rgba(213,168,79,.2);border-radius:32rpx;background:linear-gradient(135deg,#FFF9E9,#FFF);box-shadow:var(--shadow-s)}.weekly-champion__medal{position:relative;display:flex;width:88rpx;height:88rpx;flex-shrink:0;align-items:center;justify-content:center;border:6rpx solid #F3D897;border-radius:50%;background:linear-gradient(135deg,#F5D58A,#C99538);color:#FFF;box-shadow:0 8rpx 20rpx rgba(201,149,56,.25)}.weekly-champion__medal text{font-size:44rpx;line-height:1}.weekly-champion__content{min-width:0;flex:1}.weekly-champion__content view{color:#A87A2E;font-size:20rpx}.weekly-champion__content text{display:block;margin-top:6rpx;overflow:hidden;font-size:30rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.weekly-champion__points{flex-shrink:0;color:#A87A2E;font-size:26rpx;font-weight:600}.ranking-heading{display:flex;align-items:center;justify-content:space-between;margin:38rpx 4rpx 18rpx;font-size:29rpx;font-weight:600}.ranking-heading text:last-child{color:var(--text-weak);font-size:20rpx;font-weight:400}.ranking-item{display:flex;width:100%;align-items:center;gap:18rpx;margin-bottom:14rpx;padding:22rpx;border-radius:28rpx;background:var(--bg-card);box-shadow:var(--shadow-s);box-sizing:border-box}.ranking-item.is-first{border:1rpx solid rgba(213,168,79,.3);background:#FFFCF4}.ranking-item.is-me{box-shadow:0 0 0 2rpx rgba(139,92,246,.16)}.ranking-item__rank{width:40rpx;flex-shrink:0;color:var(--text-weak);font-size:28rpx;font-weight:700;text-align:center}.ranking-item.is-first .ranking-item__rank{color:#C99538}.ranking-item__avatar{display:flex;width:72rpx;height:72rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:24rpx;background:var(--bg-tint);color:var(--primary);font-size:36rpx;line-height:1}.ranking-item__content{min-width:0;flex:1}.ranking-item__content>view{display:flex;align-items:center;gap:8rpx;overflow:hidden;font-size:27rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.ranking-item__content>view text{padding:2rpx 8rpx;border-radius:8rpx;background:var(--bg-tint);color:var(--primary);font-size:17rpx}.ranking-item__medal{display:block;margin-top:5rpx;color:#B48635;font-size:19rpx}.ranking-item__points{flex-shrink:0;color:var(--text-weak);font-size:20rpx}.ranking-item__points text{margin-right:5rpx;color:var(--text-strong);font-size:34rpx;font-weight:700}.ranking-state{padding:70rpx 30rpx;color:var(--text-weak);font-size:24rpx;text-align:center}.ranking-state view{margin-top:12rpx;font-size:21rpx}.score-rules{margin-top:30rpx;padding:28rpx;border-radius:28rpx;background:rgba(255,255,255,.65);color:var(--text-normal);font-size:22rpx}.score-rules__title{margin-bottom:14rpx;color:var(--text-strong);font-size:27rpx;font-weight:600}.score-rules>view:not(.score-rules__title){display:flex;align-items:center;gap:10rpx;margin-top:10rpx}.score-rules>view>text{width:8rpx;height:8rpx;flex-shrink:0;border-radius:50%;background:var(--primary)}.score-rules p{margin:20rpx 0 0;color:var(--text-weak);font-size:20rpx;line-height:1.7}.leaderboard-bottom{height:calc(50rpx + var(--safe-bottom))}.nickname-mask{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(30,27,46,.45);box-sizing:border-box}.nickname-dialog{width:100%;max-width:600rpx;padding:36rpx;border-radius:32rpx;background:var(--bg-page);box-sizing:border-box}.nickname-dialog__title{font-size:34rpx;font-weight:700}.nickname-dialog__text{margin-top:10rpx;color:var(--text-weak);font-size:22rpx;line-height:1.6}.nickname-dialog input{height:88rpx;margin-top:28rpx;padding:0 24rpx;border:2rpx solid #E8E1F0;border-radius:22rpx;background:#FFF;font-size:27rpx;box-sizing:border-box}.nickname-dialog__error{margin-top:12rpx;color:var(--danger);font-size:21rpx}.nickname-dialog__actions{display:flex;gap:18rpx;margin-top:28rpx}.nickname-dialog__actions button{width:0;min-width:0;height:80rpx;flex:1;border-radius:40rpx;background:#EEE9F5;color:var(--text-normal);font-size:25rpx;line-height:80rpx;text-align:center}.nickname-dialog__actions button:last-child{background:var(--primary);color:#FFF}.my-score__numbers .small{margin-top:6rpx;color:rgba(255,255,255,.6);font-size:20rpx;font-weight:400}.score-rules__note{margin:20rpx 0 0;color:var(--text-weak);font-size:20rpx;line-height:1.7}
.ranking-state__icon{margin-bottom:8rpx;font-size:56rpx;line-height:1.4}@media(max-width:340px){.leaderboard-header__week{display:none}.weekly-champion__points{display:none}.my-score{padding:26rpx}.ranking-item{gap:12rpx;padding:18rpx}}
