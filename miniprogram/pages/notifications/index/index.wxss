.notifications-page{width:100%;max-width:900rpx;min-height:100vh;margin:0 auto;padding:30rpx 28rpx 0;box-sizing:border-box}.notifications-header{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:28rpx}.notifications-header>view:first-child{min-width:0;flex:1}.notifications-header__title{font-size:46rpx;font-weight:700}.notifications-header__sub{margin-top:6rpx;color:var(--text-weak);font-size:22rpx}.notifications-header__read{flex-shrink:0;color:var(--primary);font-size:23rpx}.notification-item{display:flex;width:100%;align-items:flex-start;gap:18rpx;margin-bottom:16rpx;padding:26rpx;border-radius:28rpx;background:var(--bg-card);box-shadow:var(--shadow-s);box-sizing:border-box}.notification-item__dot{width:12rpx;height:12rpx;flex-shrink:0;margin-top:12rpx;border-radius:50%;background:transparent}.notification-item.is-unread .notification-item__dot{background:var(--accent)}.notification-item__body{min-width:0;flex:1}.notification-item__title{font-size:27rpx;font-weight:600;line-height:1.5}.notification-item__text{margin-top:8rpx;overflow-wrap:anywhere;color:var(--text-normal);font-size:23rpx;line-height:1.6}.notification-item__time{margin-top:12rpx;color:var(--text-weak);font-size:20rpx}.notification-item__arrow{flex-shrink:0;color:#C3BDD2;font-size:34rpx}.notifications-state{padding:120rpx 30rpx;color:var(--text-weak);font-size:24rpx;text-align:center}.notifications-state__icon{display:flex;width:76rpx;height:76rpx;align-items:center;justify-content:center;margin:0 auto 20rpx;border-radius:50%;background:var(--bg-tint);color:var(--primary);font-size:40rpx;line-height:1}.notifications-state__title{color:var(--text-strong);font-size:28rpx;font-weight:600}.notifications-state__text{margin-top:10rpx;font-size:21rpx}.notifications-bottom{height:calc(50rpx + var(--safe-bottom))}
