.page--message {
  padding-top: 24rpx;
}

.message-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 24rpx;
}

.message-summary__unread {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.message-summary__count {
  font-size: 22rpx;
  color: var(--text-weak);
}

.message-list {
  padding: 0 24rpx;
}

.message-item {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.message-item--unread {
  box-shadow: var(--shadow-m);
}

.message-item__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.message-item__type {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
}

.message-item__time {
  font-size: 22rpx;
  color: var(--text-weak);
}

.message-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 8rpx;
}

.message-item__content {
  font-size: 26rpx;
  color: var(--text-normal);
  line-height: 1.5;
}

.message-item__dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
}

.message-loading {
  padding: 0 24rpx;
}

.message-loading__bar {
  height: 148rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  margin-bottom: 20rpx;
}

.message-more {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx auto 0;
  padding: 16rpx 40rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-tint);
}

.message-more__text {
  font-size: 26rpx;
  color: var(--primary);
}

.message-prefs {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-pref {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-m);
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-s);
}

.message-pref__label {
  font-size: 26rpx;
  color: var(--text-normal);
}

.message-pref__switch {
  transform: scale(0.85);
  transform-origin: right center;
}
