button { margin:0; padding:0; border:0; background:none; min-width:0; line-height:1.4; }
button::after { border:0; }
.countdown-page { width:100%; max-width:900rpx; min-height:100vh; margin:0 auto; padding:30rpx 28rpx 0; overflow-x:hidden; box-sizing:border-box; }
.countdown-header { display:flex; align-items:flex-end; justify-content:space-between; gap:20rpx; margin-bottom:30rpx; }
.countdown-header > view:first-child { min-width:0; flex:1; }
.countdown-header__eyebrow { color:var(--text-weak); font-size:22rpx; }
.countdown-header__title { margin-top:4rpx; font-size:54rpx; font-weight:700; letter-spacing:-2rpx; }
.countdown-header__today { max-width:260rpx; padding-bottom:8rpx; color:var(--text-weak); font-size:20rpx; text-align:right; }
.school-countdown { position:relative; padding:36rpx; overflow:hidden; border-radius:44rpx; background:linear-gradient(135deg,#7660B9,#9677C9 55%,#D59487 120%); color:#FFF; box-shadow:0 24rpx 52rpx rgba(106,80,162,.22); }
.school-countdown--school { background:linear-gradient(135deg,#4E477D,#7666A9 58%,#9D82BD 110%); }
.school-countdown__ring { position:absolute; right:-100rpx; top:-140rpx; width:250rpx; height:250rpx; border:46rpx solid rgba(255,255,255,.07); border-radius:50%; }
.school-countdown__heading { position:relative; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8rpx 16rpx; font-size:27rpx; font-weight:600; }
.school-countdown__heading text:last-child { color:rgba(255,255,255,.72); font-size:20rpx; font-weight:400; }
.school-countdown__time { display:flex; width:100%; align-items:flex-start; justify-content:center; margin:30rpx 0 26rpx; }
.school-countdown__unit { display:flex; min-width:0; max-width:112rpx; flex:1; flex-direction:column; align-items:center; }
.school-countdown__number { font-size:72rpx; font-weight:500; line-height:1.15; letter-spacing:-3rpx; }
.school-countdown__label { margin-top:8rpx; color:rgba(255,255,255,.65); font-size:20rpx; }
.school-countdown__colon { margin:8rpx -4rpx 0; color:rgba(255,255,255,.45); font-size:52rpx; }
.school-countdown__footer { display:flex; align-items:center; gap:20rpx; color:rgba(255,255,255,.68); font-size:20rpx; }
.school-countdown__footer view { height:2rpx; flex:1; background:rgba(255,255,255,.18); }
.next-schedule { position:relative; margin-top:26rpx; padding:36rpx; overflow:hidden; border:1rpx solid rgba(139,92,246,.08); border-radius:36rpx; background:var(--bg-card); box-shadow:var(--shadow-m); }
.next-schedule__eyebrow { color:var(--primary); font-size:22rpx; font-weight:600; }
.next-schedule__title { max-width:65%; margin-top:18rpx; overflow:hidden; font-size:38rpx; font-weight:700; text-overflow:ellipsis; white-space:nowrap; }
.next-schedule__date { margin-top:8rpx; color:var(--text-weak); font-size:23rpx; }
.next-schedule__count { position:absolute; right:34rpx; top:62rpx; display:flex; align-items:flex-end; gap:8rpx; color:var(--primary); }
.next-schedule__count text { font-size:86rpx; font-weight:700; line-height:1; letter-spacing:-4rpx; }
.next-schedule__count view { padding-bottom:8rpx; font-size:22rpx; }
.next-schedule__share { margin-top:28rpx; padding-top:22rpx; border-top:1rpx solid #EEE9F5; color:var(--primary-violet); font-size:22rpx; }
.upcoming-heading { display:flex; align-items:center; justify-content:space-between; margin:38rpx 4rpx 18rpx; font-size:28rpx; font-weight:600; }
.upcoming-heading text:last-child { color:var(--text-weak); font-size:21rpx; font-weight:400; }
.upcoming-item { display:flex; width:100%; align-items:center; gap:22rpx; margin-bottom:16rpx; padding:24rpx; border-radius:28rpx; background:var(--bg-card); box-shadow:var(--shadow-s); box-sizing:border-box; }
.upcoming-item__date { display:flex; width:88rpx; height:88rpx; flex-shrink:0; align-items:center; justify-content:center; gap:4rpx; border-radius:24rpx; background:var(--bg-tint); color:var(--primary); }
.upcoming-item__date text { font-size:38rpx; font-weight:700; }
.upcoming-item__date view { font-size:20rpx; }
.upcoming-item__content { min-width:0; flex:1; }
.upcoming-item__content view { overflow:hidden; font-size:27rpx; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }
.upcoming-item__content text { display:block; margin-top:6rpx; color:var(--text-weak); font-size:21rpx; }
.upcoming-item__content .upcoming-item__badge { display:inline-block; margin-top:6rpx; padding:2rpx 12rpx; border-radius:100rpx; background:var(--bg-tint); color:var(--primary); font-size:18rpx; }
.upcoming-item__arrow { flex-shrink:0; color:#C3BDD2; font-size:36rpx; }
.countdown-empty { display:flex; min-height:330rpx; flex-direction:column; align-items:center; justify-content:center; margin-top:28rpx; padding:36rpx; border:2rpx dashed #DDD5EB; border-radius:36rpx; text-align:center; box-sizing:border-box; }
.countdown-empty__icon { display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; border-radius:24rpx; background:var(--bg-tint); color:var(--primary); font-size:40rpx; line-height:1; }
.countdown-empty__title { margin-top:18rpx; font-size:28rpx; font-weight:600; }
.countdown-empty__text { margin:10rpx 0 24rpx; color:var(--text-weak); font-size:22rpx; }
.countdown-empty button { padding:16rpx 32rpx; border-radius:36rpx; background:var(--primary); color:#FFF; font-size:24rpx; }
.countdown-bottom { height:calc(160rpx + var(--safe-bottom)); }
@media(max-width:340px){.school-countdown{padding:28rpx}.school-countdown__number{font-size:60rpx}.next-schedule__count text{font-size:68rpx}.countdown-header__today{display:none}}
.school-countdown__mode{position:relative;z-index:1;display:flex;align-items:center;gap:6rpx;padding:8rpx 18rpx;border:1rpx solid rgba(255,255,255,.35);border-radius:999rpx;background:rgba(255,255,255,.14);font-size:21rpx;font-weight:500}
.school-countdown__caret{color:rgba(255,255,255,.8);font-size:20rpx}
.school-countdown__subtitle{position:relative;margin-top:10rpx;color:rgba(255,255,255,.72);font-size:21rpx}
.school-countdown__notice{position:relative;margin-top:16rpx;padding-top:14rpx;border-top:2rpx solid rgba(255,255,255,.18);color:rgba(255,255,255,.85);font-size:20rpx;line-height:1.5}
.mode-mask{position:fixed;top:0;right:0;bottom:0;left:0;z-index:20;background:rgba(24,18,44,.45)}
.mode-sheet{position:fixed;right:0;bottom:0;left:0;z-index:21;max-width:900rpx;margin:0 auto;padding:24rpx 32rpx calc(160rpx + var(--safe-bottom));border-radius:40rpx 40rpx 0 0;background:var(--bg-card);box-sizing:border-box}
.mode-sheet__handle{width:72rpx;height:8rpx;margin:0 auto 24rpx;border-radius:999rpx;background:#DDD5EB}
.mode-sheet__title{font-size:30rpx;font-weight:700}
.mode-sheet__hint{margin-top:8rpx;margin-bottom:24rpx;color:var(--text-weak);font-size:21rpx}
.mode-option{display:flex;align-items:center;gap:16rpx;margin-bottom:14rpx;padding:24rpx;border:2rpx solid transparent;border-radius:28rpx;background:var(--bg-tint)}
.mode-option--active{border-color:var(--primary);background:rgba(139,92,246,.1)}
.mode-option__body{min-width:0;flex:1}
.mode-option__label{font-size:27rpx;font-weight:600}
.mode-option__desc{display:block;margin-top:6rpx;color:var(--text-weak);font-size:20rpx}
.mode-option__time{flex-shrink:0;color:var(--primary);font-size:26rpx;font-weight:700}
.mode-option__check{flex-shrink:0;color:var(--primary);font-size:28rpx;font-weight:700}
.mode-sheet__cancel{margin-top:12rpx;padding:24rpx;border-radius:26rpx;background:var(--bg-tint);color:var(--text-normal);font-size:25rpx;text-align:center}
