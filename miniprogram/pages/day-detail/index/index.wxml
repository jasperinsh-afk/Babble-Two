<view class="day-detail">
  <view wx:if="{{schedule}}" class="day-detail__main">
    <view class="day-share-card">
      <view class="day-share-card__brand"><image src="/assets/brand/logo-mark.png" mode="aspectFit" /><text>叭啦·过日子</text></view>
      <view class="day-share-card__date">{{fullDate}}</view>
      <view class="day-share-card__title">{{schedule.title}}</view>
      <view class="day-share-card__count">
        <view class="day-share-card__label">{{countLabel}}</view>
        <view class="day-share-card__number-row">
          <text class="day-share-card__number {{countClass}}">{{dayCount}}</text><text class="day-share-card__unit">天</text>
        </view>
      </view>
      <view wx:if="{{schedule.note}}" class="day-share-card__note">{{schedule.note}}</view>
    </view>
    <view class="day-detail__actions">
      <button class="day-detail__save" loading="{{saving}}" disabled="{{saving}}" bindtap="saveShareImage">{{saving ? '正在生成' : '保存图片'}}</button>
      <button class="day-detail__share" open-type="share">分享日子</button>
    </view>
    <view wx:if="{{shareImagePath}}" class="day-share-preview">
      <image src="{{shareImagePath}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <text>若未自动保存，请长按图片保存到相册</text>
    </view>
    <button wx:if="{{!isShared}}" class="day-detail__delete" bindtap="deleteSchedule">删除这个日程</button>
  </view>

  <view wx:if="{{missing}}" class="day-detail__missing">
    <view class="day-detail__missing-icon">📅</view>
    <view class="day-detail__missing-title">没有找到这个日子</view>
    <view class="day-detail__missing-text">{{isShared ? '分享内容不完整，请向朋友重新获取' : '它可能已被删除，或保存在另一台设备上'}}</view>
    <button bindtap="goDays">返回我的日子</button>
  </view>

  <canvas canvas-id="dayShareCanvas" class="day-share-canvas" style="width:540px;height:675px;"></canvas>
</view>
