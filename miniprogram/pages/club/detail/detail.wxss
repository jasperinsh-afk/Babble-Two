.page--club-detail {
  padding-bottom: 40rpx;
}

.club-hero {
  margin: 24rpx 24rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  overflow: hidden;
  box-shadow: var(--shadow-s);
}

.club-hero__cover {
  width: 100%;
  height: 320rpx;
  background: var(--bg-tint);
  overflow: hidden;
}

.club-hero__cover image {
  width: 100%;
  height: 100%;
}

.club-hero__cover--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  color: rgba(139, 92, 246, 0.25);
  font-weight: 700;
}

.club-hero__body {
  padding: 28rpx;
}

.club-hero__name-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.club-hero__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-strong);
  margin-right: 16rpx;
}

.club-hero__verified {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 20rpx;
}

.club-hero__desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-normal);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.club-hero__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.club-hero__count {
  font-size: 24rpx;
  color: var(--text-weak);
}

.club-hero__btn {
  width: 100%;
}

.club-posts {
  padding: 0 24rpx;
}

.club-post {
  background: var(--bg-card);
  border-radius: var(--radius-l);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-s);
}

.club-post__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 12rpx;
}

.club-post__content {
  font-size: 26rpx;
  color: var(--text-normal);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.club-post__images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.club-post__img {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-m);
  background: var(--bg-tint);
}

.club-post__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-weak);
}

.club-post__pinned {
  color: var(--primary);
  font-weight: 500;
}

.club-detail__loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: var(--text-weak);
}
