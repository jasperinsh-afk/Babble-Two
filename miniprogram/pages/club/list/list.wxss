.page--club-list {
  padding-top: 8rpx;
}

.club-search {
  padding: 16rpx 24rpx;
}

.club-search__input {
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-s);
  font-size: 28rpx;
  color: var(--text-strong);
}

.club-tabs {
  padding: 8rpx 24rpx 16rpx;
}

.club-tabs__wrap {
  display: inline-flex;
}

.club-tabs__item {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: var(--bg-card);
  font-size: 26rpx;
  color: var(--text-normal);
  box-shadow: var(--shadow-s);
}

.club-tabs__item--active {
  background: var(--gradient-primary);
  color: #fff;
  box-shadow: var(--shadow-m);
}

.club-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx 40rpx;
}

.club-grid__cell {
  width: 49%;
  margin-bottom: 20rpx;
}
