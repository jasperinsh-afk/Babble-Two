<view class="home-page">
  <view class="home-topbar">
    <view class="home-topbar__brand"><image class="home-topbar__logo" src="/assets/brand/logo-mark.png" mode="aspectFit" /><text>叭啦</text></view>
  </view>

  <view class="home-hero"><view class="home-hero__date">{{todayLabel}}</view></view>

  <view wx:if="{{nextSchedule}}" class="home-focus" data-id="{{nextSchedule.id}}" bindtap="goDetail">
    <view class="home-focus__eyebrow">下一个特别的日子</view>
    <view class="home-focus__title">{{nextSchedule.title}}</view>
    <view class="home-focus__date">{{nextSchedule.dateText}}</view>
    <view class="home-focus__count"><text>{{nextSchedule.difference}}</text><view>天后</view></view>
    <view class="home-focus__link">点击查看分享页 ›</view>
  </view>
  <view wx:else class="home-focus home-focus--empty" bindtap="goCreate">
    <view class="home-focus__title">还没有日程</view>
    <view class="home-focus__link">添加我的日程</view>
  </view>

  <view class="home-shortcuts">
    <button bindtap="goDays"><view class="home-shortcuts__icon">📅</view><view><text>日程日历</text><text class="small">添加和管理日子</text></view><text class="arrow">›</text></button>
    <button bindtap="goCountdown"><view class="home-shortcuts__icon home-shortcuts__icon--orange">⏰</view><view><text>全部倒计时</text><text class="small">上下学与未来日程</text></view><text class="arrow">›</text></button>
  </view>

  <view wx:if="{{upcoming.length}}" class="home-section">
    <view class="home-section__heading"><text>近期日程</text><button bindtap="goDays">全部日程 ›</button></view>
    <view class="home-schedule" wx:for="{{upcoming}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="home-schedule__days"><text>{{item.difference}}</text><text class="small">天</text></view>
      <view class="home-schedule__content"><view>{{item.title}}</view><text>{{item.dateText}}</text></view><view class="home-schedule__arrow">›</view>
    </view>
  </view>

  <view class="home-section">
    <view class="home-section__heading"><text>本周达人</text><button bindtap="goLeaderboard">完整榜单 ›</button></view>
    <view class="home-talents" bindtap="goLeaderboard">
      <view wx:if="{{!talents.length}}" class="home-talents__empty"><view><text>🏆</text></view><view><text class="strong">本周达人榜等你来</text><text class="small">投票和添加日程都能获得达人分</text></view><text class="arrow">›</text></view>
      <view class="home-talent" wx:for="{{talents}}" wx:key="key"><view class="home-talent__rank">{{item.rank}}</view><view class="home-talent__avatar">{{item.avatar}}</view><view class="home-talent__name">{{item.nickname}}</view><view class="home-talent__points">{{item.points}} 分</view></view>
    </view>
  </view>

  <view class="home-campus" bindtap="goCalendar"><view><text>校园活动日历</text><text class="small">查看讲座、比赛与近期校园安排</text></view><text class="arrow">›</text></view>
  <view class="home-bottom"></view>
</view>
