button{margin:0;padding:0;border:0;background:none;min-width:0;line-height:1.4}button::after{border:0}.home-page{width:100%;max-width:900rpx;min-height:100vh;margin:0 auto;padding:24rpx 28rpx 0;overflow-x:hidden;box-sizing:border-box}.home-topbar{display:flex;align-items:center;justify-content:space-between}.home-topbar__brand{display:flex;align-items:center;gap:14rpx;font-size:40rpx;font-weight:700;letter-spacing:1rpx}.home-topbar__logo{width:58rpx;height:58rpx}.home-topbar__notice{position:relative;flex-shrink:0;padding:14rpx 20rpx;border-radius:28rpx;background:var(--bg-card);color:var(--text-normal);font-size:22rpx;box-shadow:var(--shadow-s)}.home-topbar__dot{position:absolute;right:10rpx;top:8rpx;width:12rpx;height:12rpx;border:3rpx solid #FFF;border-radius:50%;background:var(--danger);box-sizing:content-box}.home-hero{margin:38rpx 4rpx 26rpx}.home-hero__date{color:var(--primary);font-size:22rpx;font-weight:600}.home-hero__title{margin-top:12rpx;font-size:46rpx;font-weight:800;line-height:1.3;letter-spacing:-2rpx}.home-hero__subtitle{margin-top:10rpx;color:var(--text-weak);font-size:23rpx}.home-focus{position:relative;padding:38rpx;overflow:hidden;border-radius:40rpx;background:linear-gradient(145deg,#32284D,#685295 62%,#A77DB3);color:#FFF;box-shadow:0 24rpx 52rpx rgba(71,52,105,.24)}.home-focus:after{content:'';position:absolute;right:-80rpx;top:-100rpx;width:240rpx;height:240rpx;border:42rpx solid rgba(255,255,255,.06);border-radius:50%}.home-focus__eyebrow{position:relative;color:rgba(255,255,255,.68);font-size:22rpx}.home-focus__title{position:relative;max-width:62%;margin-top:22rpx;overflow:hidden;font-size:42rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.home-focus__date{position:relative;margin-top:10rpx;color:rgba(255,255,255,.66);font-size:23rpx}.home-focus__count{position:absolute;right:36rpx;top:82rpx;display:flex;align-items:flex-end;gap:8rpx}.home-focus__count text{font-size:108rpx;font-weight:700;line-height:1;letter-spacing:-6rpx}.home-focus__count view{padding-bottom:12rpx;color:rgba(255,255,255,.75);font-size:22rpx}.home-focus__link{position:relative;margin-top:34rpx;padding-top:24rpx;border-top:1rpx solid rgba(255,255,255,.14);color:rgba(255,255,255,.85);font-size:22rpx}.home-focus--empty{background:linear-gradient(145deg,#7660B9,#9B7AC7)}.home-focus--empty .home-focus__title{max-width:100%;font-size:36rpx}.home-shortcuts{display:flex;gap:18rpx;margin-top:24rpx}.home-shortcuts button{display:flex;width:0;min-width:0;flex:1;align-items:center;gap:14rpx;padding:22rpx;border-radius:28rpx;background:var(--bg-card);box-shadow:var(--shadow-s);text-align:left;box-sizing:border-box}.home-shortcuts__icon{display:flex;width:64rpx;height:64rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:20rpx;background:var(--bg-tint);color:var(--primary);font-size:34rpx;line-height:1}.home-shortcuts__icon--orange{background:#FFF0E5;color:var(--accent)}.home-shortcuts button>view:nth-child(2){min-width:0;flex:1}.home-shortcuts button text{display:block;font-size:24rpx;font-weight:600;white-space:nowrap}.home-shortcuts button small{display:block;margin-top:5rpx;overflow:hidden;color:var(--text-weak);font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.home-shortcuts button b,.home-campus b,.home-talents__empty b{flex-shrink:0;color:#C3BDD2;font-size:32rpx;font-weight:400}.home-section{margin-top:36rpx}.home-section__heading{display:flex;align-items:center;justify-content:space-between;margin:0 4rpx 18rpx;font-size:30rpx;font-weight:700}.home-section__heading button{color:var(--primary-violet);font-size:21rpx;font-weight:400}.home-schedule{display:flex;width:100%;align-items:center;gap:20rpx;margin-bottom:14rpx;padding:20rpx 24rpx;border-radius:28rpx;background:var(--bg-card);box-shadow:var(--shadow-s);box-sizing:border-box}.home-schedule__days{display:flex;width:78rpx;height:78rpx;flex-shrink:0;align-items:center;justify-content:center;gap:4rpx;border-radius:22rpx;background:var(--bg-tint);color:var(--primary)}.home-schedule__days text{font-size:34rpx;font-weight:700}.home-schedule__days small{font-size:18rpx}.home-schedule__content{min-width:0;flex:1}.home-schedule__content view{overflow:hidden;font-size:27rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.home-schedule__content text{display:block;margin-top:5rpx;color:var(--text-weak);font-size:21rpx}.home-schedule__arrow{color:#C3BDD2;font-size:34rpx}.home-talents{padding:8rpx 24rpx;border-radius:30rpx;background:var(--bg-card);box-shadow:var(--shadow-s)}.home-talent{display:flex;align-items:center;gap:16rpx;padding:20rpx 0;border-bottom:1rpx solid #F0EBF5}.home-talent:last-child{border-bottom:0}.home-talent__rank{width:32rpx;flex-shrink:0;color:var(--text-weak);font-size:24rpx;font-weight:700;text-align:center}.home-talent__avatar{display:flex;width:60rpx;height:60rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:20rpx;background:var(--bg-tint);color:var(--primary);font-size:24rpx}.home-talent__name{min-width:0;flex:1;overflow:hidden;font-size:25rpx;font-weight:600;text-overflow:ellipsis;white-space:nowrap}.home-talent__points{flex-shrink:0;color:var(--primary-violet);font-size:22rpx;font-weight:600}.home-talents__empty{display:flex;align-items:center;gap:18rpx;padding:26rpx 0}.home-talents__empty>view:first-child{display:flex;width:66rpx;height:66rpx;flex-shrink:0;align-items:center;justify-content:center;border-radius:50%;background:#F5D58A;color:#FFF;font-size:36rpx;line-height:1}.home-talents__empty>view:nth-child(2){min-width:0;flex:1}.home-talents__empty strong{display:block;font-size:25rpx}.home-talents__empty small{display:block;margin-top:6rpx;color:var(--text-weak);font-size:19rpx}.home-campus{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:28rpx;padding:26rpx 28rpx;border:1rpx solid rgba(139,92,246,.06);border-radius:28rpx;background:rgba(255,255,255,.55)}.home-campus>view{min-width:0;flex:1}.home-campus text{display:block;font-size:25rpx;font-weight:600}.home-campus small{display:block;margin-top:6rpx;color:var(--text-weak);font-size:20rpx}.home-bottom{height:calc(170rpx + var(--safe-bottom))}.home-shortcuts button .small{display:block;margin-top:5rpx;overflow:hidden;color:var(--text-weak);font-size:18rpx;font-weight:400;text-overflow:ellipsis;white-space:nowrap}.home-shortcuts .arrow,.home-campus .arrow,.home-talents__empty .arrow{flex-shrink:0;color:#C3BDD2;font-size:32rpx;font-weight:400}.home-schedule__days .small{font-size:18rpx}.home-campus .small{display:block;margin-top:6rpx;color:var(--text-weak);font-size:20rpx;font-weight:400}.home-talents__empty .strong{display:block;font-size:25rpx;font-weight:700}.home-talents__empty .small{display:block;margin-top:6rpx;color:var(--text-weak);font-size:19rpx;font-weight:400}
@media(max-width:340px){.home-hero__title{font-size:40rpx}.home-focus{padding:30rpx}.home-focus__count text{font-size:84rpx}.home-focus__title{font-size:36rpx}.home-shortcuts{flex-direction:column}.home-shortcuts button{width:100%;flex:none}.home-shortcuts button .small{white-space:normal}}
