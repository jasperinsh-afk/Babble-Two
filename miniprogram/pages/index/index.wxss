.page--home {
  padding-top: 8rpx;
}

.today-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.today-action {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  padding: 24rpx 28rpx;
}

.today-action--unread {
  box-shadow: var(--shadow-m);
}

.today-action__type {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--primary);
  margin-bottom: 8rpx;
}

.today-action__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 8rpx;
}

.today-action__content {
  font-size: 26rpx;
  color: var(--text-normal);
  line-height: 1.5;
}

.today-action__dot {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--danger);
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
}

.home-header__brand {
  display: flex;
  align-items: center;
}

.home-header__mark {
  width: 64rpx;
  height: 64rpx;
  margin-right: 14rpx;
}

.home-header__logo {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--text-strong);
}

.home-header__tag {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--bg-tint);
}

.home-header__scan {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-m);
  position: relative;
}

.home-header__scan::before {
  content: '';
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
}

.home-header__scan::after {
  content: '';
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  background: #fff;
  border-radius: 50%;
}

.home-banner {
  height: 320rpx;
  margin: 0 24rpx;
  border-radius: var(--radius-l);
  overflow: hidden;
  box-shadow: var(--shadow-s);
}

.home-banner__item {
  position: relative;
  width: 100%;
  height: 100%;
}

.home-banner__img {
  width: 100%;
  height: 100%;
  background: var(--bg-tint);
}

.home-banner__shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 24rpx 24rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.5), transparent);
}

.home-banner__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.home-today {
  position: relative;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  overflow: hidden;
  box-shadow: var(--shadow-s);
}

.home-today__border {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
  background: var(--gradient-primary);
}

.home-today__content {
  padding: 28rpx 28rpx 28rpx 36rpx;
}

.home-today__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 12rpx;
}

.home-today__count {
  font-size: 24rpx;
  color: var(--text-weak);
  margin-bottom: 20rpx;
}

.home-today__btn {
  display: inline-flex;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  box-shadow: var(--shadow-s);
}

.home-quick {
  display: flex;
  justify-content: space-between;
}

.home-quick__item {
  width: 132rpx;
  height: 160rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
}

.home-quick__item:active {
  transform: scale(0.94);
}

.home-quick__icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.home-quick__icon--vote { background: var(--gradient-primary); }
.home-quick__icon--club { background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); }
.home-quick__icon--calendar { background: linear-gradient(135deg, #8B5CF6 0%, #06B6D4 100%); }
.home-quick__icon--living { background: linear-gradient(135deg, #F97316 0%, #EA580C 100%); }
.home-quick__icon--scan { background: linear-gradient(135deg, #EA580C 0%, #F97316 100%); }

.home-quick__label {
  font-size: 24rpx;
  color: var(--text-normal);
}

.home-scroll {
  width: 100%;
  white-space: nowrap;
}

.home-scroll__wrap {
  display: inline-flex;
  padding-right: 24rpx;
}

.home-poll-mini {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 260rpx;
  height: 160rpx;
  padding: 24rpx;
  margin-right: 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
  vertical-align: top;
}

.home-poll-mini__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
  line-height: 1.35;
}

.home-poll-mini__count {
  font-size: 22rpx;
  color: var(--text-weak);
}

.grid-2__cell {
  margin-bottom: 20rpx;
}

/* 骨架屏 */
.home-skeleton {
  padding: 24rpx;
}

.home-skeleton__banner {
  width: 100%;
  height: 320rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  margin-bottom: 24rpx;
}

.home-skeleton__row {
  display: flex;
  gap: 24rpx;
}

.home-skeleton__card {
  flex: 1;
  height: 160rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
}
