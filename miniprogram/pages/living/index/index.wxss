/* ---------------------------------------------------------------- 生活板块聚合墙 */

.living-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.service-card {
  display: flex;
  flex-direction: column;
  width: 49%;
  margin-bottom: 24rpx;
  padding: 26rpx 24rpx;
  border-radius: var(--radius-l);
  background: var(--bg-card);
  box-shadow: var(--shadow-s);
  transition: transform 0.18s ease;
}

.service-card:active {
  transform: scale(0.97);
}

.service-card--locked {
  background: linear-gradient(180deg, #ffffff 0%, #f8f5ff 100%);
}

.service-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  color: #ffffff;
  font-size: 40rpx;
  box-shadow: var(--shadow-s);
}

.service-card__icon--calendar {
  background: linear-gradient(135deg, #8b5cf6 0%, #06b6d4 100%);
}

.service-card__icon--club {
  background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
}

.service-card__icon--circle {
  background: linear-gradient(135deg, #a78bfa 0%, #f472b6 100%);
}

.service-card__icon--lost {
  background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
}

.service-card__icon--scan {
  background: var(--gradient-primary);
}

.service-card__glyph {
  line-height: 1;
}

.service-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
  margin-bottom: 6rpx;
}

.service-card__desc {
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--text-weak);
}

.service-card__status {
  align-self: flex-start;
  margin-top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
  background: rgba(139, 92, 246, 0.1);
  color: var(--text-weak);
  font-size: 20rpx;
}

.service-card--locked .service-card__status {
  background: rgba(245, 158, 11, 0.14);
  color: var(--warning);
}

/* ---------------------------------------------------------------- 投票入口 */

.living-vote {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border-radius: var(--radius-l);
  background: var(--bg-tint);
  transition: transform 0.18s ease;
}

.living-vote:active {
  transform: scale(0.98);
}

.living-vote__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.living-vote__body {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.living-vote__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.living-vote__text {
  font-size: 22rpx;
  color: var(--text-weak);
}

.living-vote__arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: var(--text-weak);
}

/* ---------------------------------------------------------------- 生活圈 / 失物招领 */
/* campus-living 组件（styleIsolation: apply-shared）复用本页样式 */

.living-tabs {
  display: flex;
  margin: 16rpx 24rpx 24rpx;
  padding: 8rpx;
  background: var(--bg-card);
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-s);
}

.living-tabs__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text-normal);
  transition: all 0.2s ease;
}

.living-tabs__item--active {
  background: var(--gradient-primary);
  color: #ffffff;
  box-shadow: var(--shadow-s);
}

.living-channels {
  padding: 0 24rpx 20rpx;
}

.living-channels__wrap {
  display: inline-flex;
}

.living-channels__item {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  font-size: 24rpx;
  color: var(--text-normal);
  box-shadow: var(--shadow-s);
  white-space: nowrap;
}

.living-channels__item--active {
  background: var(--gradient-primary);
  color: #ffffff;
}

.living-posts,
.living-cards {
  padding: 0 24rpx 40rpx;
}

.living-post,
.living-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-l);
  box-shadow: var(--shadow-s);
}

.living-post__content {
  font-size: 26rpx;
  color: var(--text-strong);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.living-post__images {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.living-post__img {
  width: 180rpx;
  height: 180rpx;
  margin: 0 12rpx 12rpx 0;
  border-radius: var(--radius-m);
  background: var(--bg-tint);
}

.living-post__footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--text-weak);
}

.living-kind {
  display: flex;
  padding: 0 24rpx 20rpx;
}

.living-kind__item {
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  font-size: 24rpx;
  color: var(--text-normal);
  box-shadow: var(--shadow-s);
}

.living-kind__item--active {
  background: var(--gradient-primary);
  color: #ffffff;
}

.living-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.living-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong);
}

.living-card__desc {
  font-size: 24rpx;
  color: var(--text-normal);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.living-card__meta {
  font-size: 22rpx;
  color: var(--text-weak);
}
