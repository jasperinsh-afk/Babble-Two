page { background: #272238; }
.countdown-full { position: relative; display: flex; min-height: 100vh; flex-direction: column; padding-right: 40rpx; padding-bottom: calc(36rpx + var(--safe-bottom)); padding-left: 40rpx; overflow: hidden; background: linear-gradient(160deg, #272238 0%, #3D315C 55%, #514475 100%); box-sizing: border-box; }
.countdown-full__top { position: relative; display: flex; min-height: 104rpx; flex-shrink: 0; align-items: center; gap: 20rpx; color: #FFF; }
.countdown-full__back { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; border-radius: 50%; background: rgba(255,255,255,.12); font-size: 52rpx; font-weight: 300; line-height: 1; box-sizing: border-box; }
.countdown-full__brand { display: flex; margin-left: auto; align-items: center; gap: 16rpx; color: #FFF; font-family: "PingFang SC","HarmonyOS Sans SC","Microsoft YaHei",sans-serif; font-size: 32rpx; font-weight: 500; letter-spacing: 1rpx; }
.countdown-full__brand image { width: 54rpx; height: 54rpx; }
.countdown-full__body { position: relative; display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 30rpx 0 50rpx; text-align: center; }
.countdown-full__title { color: #FFF; font-size: 52rpx; font-weight: 700; line-height: 1.35; }
.countdown-full__date { margin-top: 12rpx; color: rgba(255,255,255,.62); font-size: 24rpx; }
.countdown-full__count { margin-top: 56rpx; }
.countdown-full__days { display: flex; align-items: baseline; justify-content: center; gap: 14rpx; color: #FFF; }
.countdown-full__days text { font-size: 152rpx; font-weight: 800; line-height: 1; }
.countdown-full__days view { font-size: 28rpx; opacity: .76; }
.countdown-full__time { margin-top: 22rpx; color: #FFD8A8; font-size: 40rpx; font-weight: 600; letter-spacing: 4rpx; }
.countdown-full__note { max-width: 560rpx; margin-top: 46rpx; color: rgba(255,255,255,.72); font-size: 24rpx; line-height: 1.6; }
.countdown-full__actions { position: relative; display: flex; flex-shrink: 0; gap: 20rpx; }
.countdown-full__action { display: flex; height: 88rpx; flex: 1; min-width: 0; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 44rpx; background: rgba(255,255,255,.14); color: #FFF; font-size: 26rpx; line-height: 1; box-sizing: border-box; }
.countdown-full__action::after { border: 0; }
.countdown-full__action--share { margin: 0; background: linear-gradient(100deg, #8B5CF6, #F97316); }
.countdown-share-preview { flex-shrink: 0; margin-top: 24rpx; padding: 18rpx; border-radius: 24rpx; background: #FFF; text-align: center; }
.countdown-share-preview image { display: block; width: 100%; border-radius: 16rpx; }
.countdown-share-preview text { display: block; margin-top: 12rpx; color: #5C5775; font-size: 22rpx; }
.share-canvas { position: fixed; top: -2000px; left: -2000px; width: 540px; height: 675px; pointer-events: none; }
@media (max-width: 340px) { .countdown-full__days text { font-size: 120rpx; } .countdown-full__title { font-size: 44rpx; } .countdown-full__action { font-size: 23rpx; } }
